        target_content: "    const created = await createUser({\n      fullName,\n      email: normEmail,\n      phone,\n      password: hashedPassword, // passed down securely\n      accountNumber,\n      sortCode,\n      currency: currency as CurrencyCode,\n      balance: 1000.00, // Pre-fund mock banking accounts with 1,000 to allow transfers out-of-the-box\n      isVerified: false,\n    } as any);\n\n    res.status(201).json({\n      userId: created._id,\n      email: created.email,\n      phone: created.phone,\n      isVerified: false,\n      message: \"Registration successful. Please proceed to OTP dispatch.\",\n    });"
        replacement_content: "    const created = await createUser({\n      fullName,\n      email: normEmail,\n      phone,\n      password: hashedPassword, // passed down securely\n      accountNumber,\n      sortCode,\n      currency: currency as CurrencyCode,\n      balance: 1000.00, // Pre-fund mock banking accounts with 1,000 to allow transfers out-of-the-box\n      isVerified: false,\n    } as any);\n\n    // Send Welcome Email containing their Account Number\n    const transporter = getMailTransporter();\n    const emailSubject = \"Welcome to AdrieChartered - Your Account Details\";\n    const emailContent = `Dear ${fullName},\n\nThank you for choosing AdrieChartered for your digital banking. We are excited to support your financial journey.\n\nYour personal account has been successfully provisioned. Here are your credentials:\n\n- Full Name: ${fullName}\n- Account Number: ${accountNumber}  <-- USE THIS TO SIGN IN OR AUTHORIZE\n- Sort Code: ${sortCode}\n- Opening Balance: ${currency} 1,000.00 (Complimentary pre-funded credit)\n\nPlease use your Email Address or your new Account Number (${accountNumber}) alongside your chosen password to access your online banking panel.\n\nBest regards,\nAdrieChartered Support Team`;\n\n    let emailSent = false;\n    let emailStatus = \"\";\n    if (transporter) {\n      try {\n        await transporter.sendMail({\n          from: `\"AdrieChartered Support\" <${process.env.EMAIL_USER}>`,\n          to: normEmail,\n          subject: emailSubject,\n          text: emailContent,\n        });\n        emailSent = true;\n        emailStatus = \"DELIVERED LIVE VIA SMTP\";\n      } catch (err: any) {\n        console.error(\"Welcome SMTP Delivery Failed:\", err.message);\n        emailStatus = `SMTP failure: ${err.message}`;\n      }\n    } else {\n      emailStatus = \"MOCKED (No SMTP credentials configured)\";\n    }\n\n    console.log(`\\n=============================================================`);\n    console.log(`[WELCOME DISPATCH]: New Account Details for ${fullName}`);\n    console.log(`[RECIPIENT EMAIL]:  ${normEmail}`);\n    console.log(`[ACCOUNT NUMBER]:   ${accountNumber}`);\n    console.log(`[SORT CODE]:       ${sortCode}`);\n    console.log(`[STATUS]:          ${emailStatus}`);\n    console.log(`=============================================================\\n`);\n\n    res.status(201).json({\n      userId: created._id,\n      email: created.email,\n      phone: created.phone,\n      accountNumber: created.accountNumber,\n      isVerified: false,\n      message: \"Registration successful. Welcome email dispatched with your new Account Number.\",\n    });"
      }
