          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        parts.push(match.substring(i, i + 4));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
