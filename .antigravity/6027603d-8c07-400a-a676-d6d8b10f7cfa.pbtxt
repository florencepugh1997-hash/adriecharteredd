  file_change {
    absolute_path_uri: "file:///src/components/DashboardView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState, useEffect } from \"react\";\nimport { useApp } from \"../context/AppContext.jsx\";\nimport { CURRENCIES, Transaction } from \"../types.js\";\nimport { Home, Send, History as HistoryIcon, User as UserIcon, PlusCircle, ArrowUpRight, ArrowDownLeft, Shield, Bell, HelpCircle, ArrowRight, Loader } from \"lucide-react\";\n\nimport FundView from \"./FundView.jsx\";\nimport TransferView from \"./TransferView.jsx\";\nimport HistoryView from \"./HistoryView.jsx\";\nimport ProfileView from \"./ProfileView.jsx\";\n\nexport default function DashboardView() {\n  const { user, token, databaseMode, refreshUserData } = useApp();\n\n  const [activeTab, setActiveTab] = useState<\"home\" | \"send\" | \"history\" | \"profile\">(\"home\");\n  const [showFundModal, setShowFundModal] = useState(false);\n  const [recentTransactions, setRecentTransactions] = useState<Transaction[]>([]);\n  const [loadingRecent, setLoadingRecent] = useState(false);\n\n  useEffect(() => {\n    if (activeTab === \"home\") {\n      fetchRecentLedger();\n      refreshUserData();\n    }\n  }, [activeTab, token]);\n\n  const fetchRecentLedger = async () => {\n    if (!token) return;\n    setLoadingRecent(true);\n    try {\n      const queryParams = new URLSearchParams({\n        page: \"1\",\n        limit: \"5\", // fetch latest 5 matching\n      });\n      const res = await fetch(`/api/transactions?${queryParams.toString()}`, {\n        headers: {\n          Authorization: `Bearer ${token}`,\n        },\n      });\n      if (res.ok) {\n        const data = await res.json();\n        setRecentTransactions(data.transactions);\n      }\n    } catch (err) {\n      console.error(\"Failed to query core ledger:\", err);\n    } finally {\n      setLoadingRecent(false);\n    }\n  };\n\n  if (!user) return null;\n\n  // Retrieve matching config\n  const currentCurrency = CURRENCIES.find((c) => c.code === user.currency) || CURRENCIES[0];\n\n  // Mask Account Number on Card: display only last 4 digits\n  const maskedAccountNumber = `\342\200\242\342\200\242\342\200\242\342\200\242 \342\200\242\342\200\242\342\200\242\342\200\242 ${user.accountNumber.slice(-4)}`;\n\n  // Custom greeting helper\n  const getGreeting = () => {\n    const hrs = new Date().getHours();\n    if (hrs < 12) return \"Good morning\";\n    if (hrs < 17) return \"Good afternoon\";\n    return \"Good evening\";\n  };\n\n  const getFirstName = () => {\n    return user.fullName.split(\" \")[0];\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-50/50 pb-24 text-slate-900 flex flex-col w-full\">\n      {/* 1. Global Navigation Top Header */}\n      <header className=\"sticky top-0 bg-white border-b border-slate-100 z-30 px-4 h-16 flex items-center justify-between\">\n        <div className=\"flex items-center gap-2.5\">\n          <div className=\"w-9 h-9 rounded-lg bg-[#4A90D9] flex items-center justify-center shadow-xs\">\n            <span className=\"text-white font-extrabold text-base tracking-tighter\">AC</span>\n          </div>\n          <div className=\"flex flex-col\">\n            <span className=\"text-sm font-bold text-slate-950 tracking-tight leading-none\">AdrieChartered</span>\n            <span className=\"text-[8px] text-slate-400 font-mono tracking-widest mt-1 uppercase\">UK Portal</span>\n          </div>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          {/* Active Framework Indicator Badge */}\n          <span className=\"hidden sm:inline-flex items-center gap-1.5 px-3 py-1 bg-blue-50/50 border border-blue-100 rounded-full text-[10px] font-mono text-slate-500 font-semibold uppercase\">\n            <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse\" />\n            {databaseMode}\n          </span>\n\n          <button className=\"w-9 h-9 rounded-xl hover:bg-slate-50 flex items-center justify-center text-slate-500 relative cursor-pointer border-0 bg-transparent\">\n            <Bell className=\"w-4.5 h-4.5\" />\n            <span className=\"absolute top-2 right-2 w-2 h-2 rounded-full bg-[#4A90D9]\" />\n          </button>\n        </div>\n      </header>\n\n      {/* 2. Main Content Center Body */}\n      <main className=\"flex-grow max-w-4xl w-full mx-auto p-4 md:p-6 space-y-6\">\n        {/* VIEW: HOME PAGE SUBVIEW */}\n        {activeTab === \"home\" && (\n          <div className=\"space-y-6 animate-fade-in\">\n            {/* Hour Greetings, greeting [First Name] */}\n            <div className=\"flex flex-col gap-1\">\n              <h2 className=\"text-xl font-bold font-sans tracking-tight text-slate-950\">\n                {getGreeting()}, {getFirstName()}\n              </h2>\n              <p className=\"text-xs text-slate-400 font-medium\">Welcome back to your secure digital banking portal</p>\n            </div>\n\n            {/* Custom Account Graphic Debit Card */}\n            <div className=\"relative bg-gradient-to-br from-[#4A90D9] to-sky-650 rounded-2xl p-6 text-white shadow-lg overflow-hidden border border-blue-400/25\">\n              {/* Card visual elements */}\n              <div className=\"absolute -right-12 -top-12 w-40 h-40 bg-white/5 rounded-full blur-2xl\" />\n              <div className=\"absolute right-0 bottom-0 w-32 h-32 bg-white/5 rounded-full blur-xl\" />\n\n              <div className=\"flex justify-between items-start mb-10\">\n                <div>\n                  <span className=\"block text-[9px] font-semibold text-blue-100 font-mono uppercase tracking-widest\">Personal Account</span>\n                  <div className=\"text-2xl font-bold font-mono tracking-wide mt-1.5\">\n                    {currentCurrency.symbol}\n                    {user.balance.toLocaleString(\"en-GB\", { minimumFractionDigits: 2 })}\n                  </div>\n                </div>\n\n                <div className=\"flex flex-col items-end\">\n                  <span className=\"font-extrabold text-white text-lg tracking-tight\">AC</span>\n                  <span className=\"text-[10px] text-blue-150 font-mono mt-1 font-semibold tracking-wide\">AdrieChartered</span>\n                </div>\n              </div>\n\n              <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-4 border-t border-white/10 mt-4\">\n                <div className=\"grid grid-cols-2 gap-x-6 gap-y-1\">\n                  <div>\n                    <span className=\"block text-[8px] font-bold text-blue-100 uppercase tracking-widest font-mono\">Account Number</span>\n                    <span className=\"text-xs font-mono tracking-widest font-bold\">\n                      {maskedAccountNumber}\n                    </span>\n                  </div>\n                  <div>\n                    <span className=\"block text-[8px] font-bold text-blue-100 uppercase tracking-widest font-mono\">Sort Code</span>\n                    <span className=\"text-xs font-mono tracking-widest font-bold\">\n                      {user.sortCode}\n                    </span>\n                  </div>\n                </div>\n\n                <div className=\"self-end sm:self-auto bg-white/10 px-3 py-1.5 rounded-xl border border-white/5 flex items-center gap-1.5\">\n                  <span className=\"text-lg\">{currentCurrency.flag}</span>\n                  <span className=\"text-[10px] font-bold font-mono tracking-wider\">\n                    {user.currency}\n                  </span>\n                </div>\n              </div>\n            </div>\n\n            {/* In-app action toggles */}\n            <div className=\"grid grid-cols-2 gap-4\">\n              <button\n                onClick={() => setShowFundModal(true)}\n                className=\"p-4 rounded-2xl bg-white border border-slate-100 shadow-xs hover:shadow-md hover:border-blue-250 flex items-center gap-3.5 text-left cursor-pointer transition-all active:scale-[0.98]\"\n              >\n                <div className=\"w-10 h-10 rounded-xl bg-blue-50 text-[#4A90D9] flex items-center justify-center shrink-0\">\n                  <PlusCircle className=\"w-5.5 h-5.5\" />\n                </div>\n                <div>\n                  <span className=\"block text-xs font-bold text-slate-800\">Add Money</span>\n                  <span className=\"text-[10px] text-slate-450 mt-1\">Direct mock funding</span>\n                </div>\n              </button>\n\n              <button\n                onClick={() => setActiveTab(\"send\")}\n                className=\"p-4 rounded-2xl bg-white border border-slate-100 shadow-xs hover:shadow-md hover:border-blue-250 flex items-center gap-3.5 text-left cursor-pointer transition-all active:scale-[0.98]\"\n              >\n                <div className=\"w-10 h-10 rounded-xl bg-blue-50 text-[#4A90D9] flex items-center justify-center shrink-0\">\n                  <ArrowUpRight className=\"w-5.5 h-5.5\" />\n                </div>\n                <div>\n                  <span className=\"block text-xs font-bold text-slate-800\">Send Money</span>\n                  <span className=\"text-[10px] text-slate-450 mt-1\">Rapid UK transfers</span>\n                </div>\n              </button>\n            </div>\n\n            {/* Inward fund deposit Overlay widget */}\n            {showFundModal && (\n              <div className=\"fixed inset-0 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4 z-50\">\n                <FundView\n                  onSuccess={() => {\n                    setShowFundModal(false);\n                    fetchRecentLedger();\n                    refreshUserData();\n                  }}\n                  onCancel={() => setShowFundModal(false)}\n                />\n              </div>\n            )}\n\n            {/* Recent Payments Section */}\n            <div className=\"bg-white rounded-2xl p-5 border border-slate-100 shadow-xs\">\n              <div className=\"flex items-center justify-between mb-4 border-b border-slate-55 pb-3\">\n                <span className=\"text-xs font-bold uppercase text-slate-400 tracking-wider\">Recent Outlays</span>\n                {recentTransactions.length > 5 && (\n                  <button\n                    onClick={() => setActiveTab(\"history\")}\n                    className=\"inline-flex items-center gap-1 text-[10px] font-bold text-[#4A90D9] hover:underline bg-transparent border-0 cursor-pointer p-0\"\n                  >\n                    <span>View Statement</span>\n                    <ArrowRight className=\"w-3.5 h-3.5\" />\n                  </button>\n                )}\n              </div>\n\n              {loadingRecent ? (\n                <div className=\"flex items-center justify-center py-6 gap-2\">\n                  <Loader className=\"w-4.5 h-4.5 animate-spin text-[#4A90D9]\" />\n                  <span className=\"text-xs text-slate-400 font-medium\">Synchronizing latest ledger...</span>\n                </div>\n              ) : recentTransactions.length === 0 ? (\n                <div className=\"py-12 text-center border-2 border-dashed border-slate-100 rounded-xl bg-slate-50/50\">\n                  <span className=\"block text-slate-400 text-xs font-medium\">No recent transactions recorded</span>\n                  <button\n                    onClick={() => setShowFundModal(true)}\n                    className=\"mt-3 inline-flex items-center px-4 h-8 bg-[#4A90D9] hover:bg-[#3b7fc7] text-white rounded-lg text-xs font-semibold cursor-pointer select-none\"\n                  >\n                    Add Money to Start\n                  </button>\n                </div>\n              ) : (\n                <div className=\"divide-y divide-slate-100\">\n                  {recentTransactions.map((tx) => {\n                    const txCurrency = CURRENCIES.find((c) => c.code === tx.currency) || currentCurrency;\n                    const cleanDate = new Date(tx.createdAt).toLocaleDateString(\"en-GB\", {\n                      day: \"2-digit\",\n                      month: \"2-digit\",\n                    });\n\n                    return (\n                      <div key={tx._id} className=\"py-3.5 flex items-center justify-between hover:bg-slate-50/30 transition-colors\">\n                        <div className=\"flex items-center gap-3\">\n                          {tx.type === \"credit\" ? (\n                            <div className=\"w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 border border-emerald-100\">\n                              <ArrowDownLeft className=\"w-4 h-4\" />\n                            </div>\n                          ) : (\n                            <div className=\"w-9 h-9 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center shrink-0 border border-rose-100\">\n                              <ArrowUpRight className=\"w-4 h-4\" />\n                            </div>\n                          )}\n\n                          <div>\n                            <span className=\"block text-xs font-bold text-slate-800\">\n                              {tx.type === \"credit\" ? \"Account Deposit\" : tx.recipientName}\n                            </span>\n                            <span className=\"block text-[9px] text-slate-400 font-mono mt-0.5\">\n                              {cleanDate} \342\200\242 {tx.type === \"credit\" ? \"Cleared\" : tx.recipientBank}\n                            </span>\n                          </div>\n                        </div>\n\n                        <div className=\"text-right\">\n                          <span className={`font-mono text-xs font-bold ${tx.type === \"credit\" ? \"text-emerald-600\" : \"text-slate-800\"}`}>\n                            {tx.type === \"credit\" ? \"+\" : \"-\"}{txCurrency.symbol}\n                            {tx.amount.toLocaleString(\"en-GB\", { minimumFractionDigits: 2 })}\n                          </span>\n                        </div>\n                      </div>\n                    );\n                  })}\n                </div>\n              )}\n            </div>\n          </div>\n        )}\n\n        {/* VIEW: OUTBOUND PAYMENTS VIEW (TRANSFER) */}\n        {activeTab === \"send\" && (\n          <div className=\"animate-fade-in\">\n            <TransferView onSuccessClose={() => setActiveTab(\"home\")} />\n          </div>\n        )}\n\n        {/* VIEW: SEARCHABLE PAGINATED STATEMENT HISTORY (HISTORY) */}\n        {activeTab === \"history\" && (\n          <div className=\"animate-fade-in\">\n            <HistoryView />\n          </div>\n        )}\n\n        {/* VIEW: DIGITAL USER PROFILE & CURRENCY CONTROL (PROFILE) */}\n        {activeTab === \"profile\" && (\n          <div className=\"animate-fade-in\">\n            <ProfileView />\n          </div>\n        )}\n      </main>\n\n      {/* 3. Global Navigation Sticky Bottom Bar */}\n      <nav className=\"fixed bottom-0 left-0 right-0 bg-white border-t border-slate-100 z-40 h-16 shadow-lg flex items-center px-3 justify-around max-w-4xl mx-auto rounded-t-2xl\">\n        {/* Tab 1: Home */}\n        <button\n          onClick={() => setActiveTab(\"home\")}\n          className={`flex flex-col items-center gap-1.5 p-2 bg-transparent border-0 cursor-pointer ${\n            activeTab === \"home\" ? \"text-[#4A90D9]\" : \"text-slate-400 hover:text-slate-650\"\n          }`}\n        >\n          <Home className=\"w-5 h-5\" />\n          <span className=\"text-[10px] font-bold tracking-wide\">Home</span>\n        </button>\n\n        {/* Tab 2: Send Payment */}\n        <button\n          onClick={() => setActiveTab(\"send\")}\n          className={`flex flex-col items-center gap-1.5 p-2 bg-transparent border-0 cursor-pointer ${\n            activeTab === \"send\" ? \"text-[#4A90D9]\" : \"text-slate-400 hover:text-slate-650\"\n          }`}\n        >\n          <Send className=\"w-5 h-5\" />\n          <span className=\"text-[10px] font-bold tracking-wide\">Send</span>\n        </button>\n\n        {/* Tab 3: Ledger statement */}\n        <button\n          onClick={() => setActiveTab(\"history\")}\n          className={`flex flex-col items-center gap-1.5 p-2 bg-transparent border-0 cursor-pointer ${\n            activeTab === \"history\" ? \"text-[#4A90D9]\" : \"text-slate-400 hover:text-slate-650\"\n          }`}\n        >\n          <HistoryIcon className=\"w-5 h-5\" />\n          <span className=\"text-[10px] font-bold tracking-wide\">History</span>\n        </button>\n\n        {/* Tab 4: Profile settings */}\n        <button\n          onClick={() => setActiveTab(\"profile\")}\n          className={`flex flex-col items-center gap-1.5 p-2 bg-transparent border-0 cursor-pointer ${\n            activeTab === \"profile\" ? \"text-[#4A90D9]\" : \"text-slate-400 hover:text-slate-650\"\n          }`}\n        >\n          <UserIcon className=\"w-5 h-5\" />\n          <span className=\"text-[10px] font-bold tracking-wide\">Profile</span>\n        </button>\n      </nav>\n    </div>\n  );\n}\n"
