  file_change {
    absolute_path_uri: "file:///src/components/OnboardingView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { useApp } from \"../context/AppContext\";\nimport { motion, AnimatePresence } from \"motion/react\";\nimport { ShieldCheck, ArrowRight, Sparkles, Cpu, Award, Globe, Database, ArrowUpRight, CheckCircle } from \"lucide-react\";\n\ninterface BenefitSlide {\n  title: string;\n  tagline: string;\n  description: string;\n  icon: React.ReactNode;\n  stat: string;\n  statLabel: string;\n}\n\nexport default function OnboardingView() {\n  const { setView } = useApp();\n  const [activeSlide, setActiveSlide] = useState(0);\n\n  const benefits: BenefitSlide[] = [\n    {\n      title: \"Prestigious Direct Clearing Node\",\n      tagline: \"Unbeatable Electronic Transit Speed\",\n      description: \"Direct clearing node access allows instant electronic fund inflows and direct transfers worldwide, backed by secure Automated SMTP notification receipts.\",\n      icon: <Cpu className=\"w-8 h-8 text-[#4A90D9]\" />,\n      stat: \"4 ms\",\n      statLabel: \"Average clearing execution\"\n    },\n    {\n      title: \"Bespoke Multi-Currency Vault\",\n      tagline: \"Sovereign Asset Orchestration\",\n      description: \"Operate and balance accounts dynamically across 16 global sovereign currencies. Protect and exchange capital with real-time currency conversion rates.\",\n      icon: <Globe className=\"w-8 h-8 text-[#4A90D9]\" />,\n      stat: \"16\",\n      statLabel: \"Sovereign global currencies supported\"\n    },\n    {\n      title: \"Comprehensive Security & Audits\",\n      tagline: \"Cryptographic Asset Defense\",\n      description: \"Your wealth is defended with state-of-the-art multi-step dynamic OTP verification codes, bcrypt military-grade password hashing, and active compliance approval queues.\",\n      icon: <ShieldCheck className=\"w-8 h-8 text-[#4A90D9]\" />,\n      stat: \"100%\",\n      statLabel: \"Compliance verification guarantee\"\n    }\n  ];\n\n  return (\n    <div className=\"w-full max-w-4xl bg-white rounded-[32px] shadow-2xl border border-blue-100 overflow-hidden relative flex flex-col md:flex-row min-h-[580px] font-sans\">\n      {/* Decorative Branding Line */}\n      <div className=\"absolute top-0 left-0 right-0 h-1.5 bg-[#4A90D9] z-10\" />\n\n      {/* Left side: Premium Branding & Dynamic Benefit presentation */}\n      <div className=\"w-full md:w-1/2 bg-slate-900 text-white p-8 md:p-10 flex flex-col justify-between relative overflow-hidden\">\n        {/* Subtle decorative background glow grids */}\n        <div className=\"absolute -top-12 -left-12 w-64 h-64 bg-slate-800 rounded-full blur-3xl opacity-30 pointer-events-none\" />\n        <div className=\"absolute -bottom-12 -right-12 w-64 h-64 bg-[#4A90D9]/20 rounded-full blur-3xl opacity-30 pointer-events-none\" />\n\n        {/* Brand Header */}\n        <div className=\"z-10\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-[#4A90D9] flex items-center justify-center shadow-lg\">\n              <span className=\"text-white font-bold text-xl tracking-tighter\">AC</span>\n            </div>\n            <div>\n              <h2 className=\"text-lg font-bold tracking-tight text-white\">AdrieChartered</h2>\n              <p className=\"text-[9px] font-mono tracking-widest text-[#4A90D9] uppercase font-bold\">Private Wealth Bank</p>\n            </div>\n          </div>\n        </div>\n\n        {/* Benefit Info Section with smooth fade triggers */}\n        <div className=\"my-10 z-10 space-y-6\">\n          <AnimatePresence mode=\"wait\">\n            <motion.div\n              key={activeSlide}\n              initial={{ opacity: 0, x: -10 }}\n              animate={{ opacity: 1, x: 0 }}\n              exit={{ opacity: 0, x: 10 }}\n              transition={{ duration: 0.25 }}\n              className=\"space-y-4\"\n            >\n              <div className=\"flex items-center gap-3.5\">\n                <div className=\"p-2.5 bg-slate-800 rounded-xl border border-slate-700/50 shadow-inner\">\n                  {benefits[activeSlide].icon}\n                </div>\n                <div className=\"text-[10px] font-mono tracking-wider text-[#4A90D9] font-bold uppercase\">\n                  {benefits[activeSlide].tagline}\n                </div>\n              </div>\n\n              <h1 className=\"text-xl md:text-2xl font-bold tracking-tight text-slate-100 leading-snug\">\n                {benefits[activeSlide].title}\n              </h1>\n\n              <p className=\"text-xs text-slate-350 leading-relaxed font-normal\">\n                {benefits[activeSlide].description}\n              </p>\n\n              {/* Slide Counter Statistics */}\n              <div className=\"pt-4 bg-slate-850/50 border-t border-slate-800/40 mt-4 flex items-center gap-3\">\n                <span className=\"text-2xl font-mono font-bold text-[#4A90D9] leading-none\">\n                  {benefits[activeSlide].stat}\n                </span>\n                <span className=\"text-[9px] text-slate-400 font-medium leading-tight uppercase font-mono tracking-wider\">\n                  {benefits[activeSlide].statLabel}\n                </span>\n              </div>\n            </motion.div>\n          </AnimatePresence>\n        </div>\n\n        {/* Slide Indicator Dots or Tabs */}\n        <div className=\"z-10 flex gap-2\">\n          {benefits.map((_, idx) => (\n            <button\n              key={idx}\n              onClick={() => setActiveSlide(idx)}\n              className={`h-2 rounded-full cursor-pointer transition-all border-0 focus:outline-none ${idx === activeSlide ? \"w-8 bg-[#4A90D9]\" : \"w-2 bg-slate-700 hover:bg-slate-500\"}`}\n              aria-label={`Show slide ${idx + 1}`}\n            />\n          ))}\n        </div>\n      </div>\n\n      {/* Right side: Interactive Member Entry Selector */}\n      <div className=\"w-full md:w-1/2 p-8 md:p-10 flex flex-col justify-between bg-white relative\">\n        <div className=\"space-y-6\">\n          <div className=\"space-y-1\">\n            <span className=\"text-[9px] uppercase tracking-widest font-mono font-bold text-slate-400\">Security Gate Block</span>\n            <h1 className=\"text-2xl font-bold text-slate-900 tracking-tight\">Access Gate Node</h1>\n            <p className=\"text-xs text-slate-500\">\n              Welcome to the private digital banking terminal. Please choose your entry portal below to proceed securely.\n            </p>\n          </div>\n\n          {/* Elegant Onboarding Callout Info Box */}\n          <div className=\"bg-blue-50/50 rounded-2xl border border-blue-100/40 p-4 space-y-2\">\n            <div className=\"flex items-center gap-2\">\n              <Sparkles className=\"w-4 h-4 text-[#4A90D9]\" />\n              <span className=\"text-xs font-bold text-slate-800\">Private Member Privileges</span>\n            </div>\n            <ul className=\"text-[10px] text-slate-600 space-y-1.5 pl-1\">\n              <li className=\"flex items-center gap-2\">\n                <CheckCircle className=\"w-3.5 h-3.5 text-emerald-500 shrink-0\" />\n                <span>Immediate pre-authorized opening balance of \302\2431,000.00</span>\n              </li>\n              <li className=\"flex items-center gap-2\">\n                <CheckCircle className=\"w-3.5 h-3.5 text-emerald-500 shrink-0\" />\n                <span>Bespoke custom 10-digit Preferred Account Numbers</span>\n              </li>\n              <li className=\"flex items-center gap-2\">\n                <CheckCircle className=\"w-3.5 h-3.5 text-emerald-500 shrink-0\" />\n                <span>Dynamic real-time compliance queue tracking</span>\n              </li>\n            </ul>\n          </div>\n\n          {/* Portal Entry Buttons */}\n          <div className=\"space-y-3 pt-2\">\n            <button\n              onClick={() => setView(\"login\")}\n              className=\"w-full h-12 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-xl text-xs flex items-center justify-between px-5 cursor-pointer shadow-lg hover:shadow-slate-300 transition-all cursor-pointer group\"\n            >\n              <span>Access Online Banking Panel</span>\n              <ArrowRight className=\"w-4 h-4 text-[#4A90D9] group-hover:translate-x-1.5 transition-transform\" />\n            </button>\n\n            <button\n              onClick={() => setView(\"signup\")}\n              className=\"w-full h-12 bg-white hover:bg-slate-50 text-slate-800 font-bold rounded-xl text-xs flex items-center justify-between px-5 border border-slate-200 cursor-pointer shadow-xs transition-all group\"\n            >\n              <span>Open Private Wealth Account</span>\n              <ArrowUpRight className=\"w-4 h-4 text-slate-400 group-hover:translate-y-[-2px] group-hover:translate-x-[2px] transition-transform\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Regulatory footer */}\n        <div className=\"mt-8 md:mt-0 text-[9px] text-slate-400 font-light leading-relaxed select-none text-center border-t border-slate-100 pt-4\">\n          AdrieChartered Bank PLC is authorized by the Prudential Regulation Authority and regulated under Compliance Act 1682. All funds protected by financial safety guidelines.\n        </div>\n      </div>\n    </div>\n  );\n}"
    }
