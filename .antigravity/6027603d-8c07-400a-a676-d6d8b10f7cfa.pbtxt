  file_change {
    absolute_path_uri: "file:///src/components/FundView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { useApp } from \"../context/AppContext.jsx\";\nimport { CURRENCIES } from \"../types.js\";\nimport { PlusCircle, Loader, DollarSign, X } from \"lucide-react\";\n\ninterface FundViewProps {\n  onSuccess: () => void;\n  onCancel: () => void;\n}\n\nexport default function FundView({ onSuccess, onCancel }: FundViewProps) {\n  const { user, fundAccount } = useApp();\n  \n  const [amount, setAmount] = useState(\"\");\n  const [description, setDescription] = useState(\"\");\n  const [isSubmitting, setIsSubmitting] = useState(false);\n  const [error, setError] = useState(\"\");\n\n  if (!user) return null;\n\n  // Retrieve current active config matching user\'s selected preference\n  const currentCurrency = CURRENCIES.find((c) => c.code === user.currency) || CURRENCIES[0];\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setError(\"\");\n\n    const numAmount = Number(amount);\n    if (!amount || isNaN(numAmount) || numAmount <= 0) {\n      setError(\"Please provide a valid deposit amount greater than zero.\");\n      return;\n    }\n\n    setIsSubmitting(true);\n    try {\n      await fundAccount(numAmount, description || \"Mock electronic fund ingestion\");\n      onSuccess();\n    } catch (err: any) {\n      setError(err.message || \"Fund account ingestion request rejected.\");\n    } finally {\n      setIsSubmitting(false);\n    }\n  };\n\n  return (\n    <div className=\"bg-white rounded-2xl border border-blue-100 shadow-md p-6 max-w-md w-full relative\">\n      <button \n        onClick={onCancel}\n        className=\"absolute top-4 right-4 text-slate-400 hover:text-slate-600 bg-transparent border-0 cursor-pointer p-1\"\n        disabled={isSubmitting}\n      >\n        <X className=\"w-5 h-5\" />\n      </button>\n\n      <div className=\"flex items-center gap-2.5 mb-5 border-b border-slate-100 pb-3\">\n        <div className=\"w-9 h-9 rounded-lg bg-blue-100 flex items-center justify-center text-[#4A90D9]\">\n          <PlusCircle className=\"w-5 h-5\" />\n        </div>\n        <div>\n          <h3 className=\"text-base font-bold text-slate-900\">Add Money Online</h3>\n          <p className=\"text-[10px] text-slate-500 font-mono\">Immediate electronic clearing</p>\n        </div>\n      </div>\n\n      <form onSubmit={handleSubmit} className=\"space-y-4\">\n        <div>\n          <label className=\"block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1.5\">Amount ({user.currency})</label>\n          <div className=\"relative\">\n            <span className=\"absolute left-4 top-1/2 -translate-y-1/2 font-mono font-bold text-slate-400 text-lg\">\n              {currentCurrency.symbol}\n            </span>\n            <input\n              type=\"text\"\n              pattern=\"^[0-9]+(\\.[0-9]{1,2})?$\"\n              value={amount}\n              onChange={(e) => setAmount(e.target.value)}\n              className=\"w-full pl-10 pr-4 h-11 bg-slate-50 border border-slate-200 rounded-xl text-lg font-mono font-semibold focus:bg-white focus:border-[#4A90D9] outline-none transition-all placeholder:text-slate-350\"\n              placeholder=\"0.00\"\n              disabled={isSubmitting}\n              required\n            />\n          </div>\n          <span className=\"block text-[10px] text-slate-400 font-mono mt-1\">Accepts decimal numeric values up to 2 places</span>\n        </div>\n\n        <div>\n          <label className=\"block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1.5\">Description (Optional)</label>\n          <input\n            type=\"text\"\n            value={description}\n            onChange={(e) => setDescription(e.target.value)}\n            className=\"w-full px-4 h-10 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:border-[#4A90D9] outline-none transition-all placeholder:text-slate-400\"\n            placeholder=\"e.g. PayPal Withdrawal, Savings Transfer\"\n            disabled={isSubmitting}\n          />\n        </div>\n\n        {error && (\n          <div className=\"p-3 bg-rose-50 border border-rose-150 rounded-xl text-xs font-medium text-rose-700 leading-snug\">\n            {error}\n          </div>\n        )}\n\n        <div className=\"flex gap-3 pt-2\">\n          <button\n            type=\"button\"\n            onClick={onCancel}\n            className=\"flex-grow h-10 border border-slate-200 hover:bg-slate-50 text-slate-650 font-medium rounded-xl text-xs transition-all cursor-pointer bg-white\"\n            disabled={isSubmitting}\n          >\n            Cancel\n          </button>\n          <button\n            type=\"submit\"\n            className=\"flex-grow h-10 bg-[#4A90D9] hover:bg-[#3b7fc7] disabled:bg-[#4A90D9]/50 text-white font-medium rounded-xl text-xs items-center justify-center flex gap-1.5 transition-all cursor-pointer shadow-md shadow-blue-500/10\"\n            disabled={isSubmitting}\n          >\n            {isSubmitting ? (\n              <>\n                <Loader className=\"w-3.5 h-3.5 animate-spin\" />\n                <span>Processing Deposit...</span>\n              </>\n            ) : (\n              <>\n                <PlusCircle className=\"w-4 h-4\" />\n                <span>Add Mock Funds</span>\n              </>\n            )}\n          </button>\n        </div>\n      </form>\n    </div>\n  );\n}\n"
    }
