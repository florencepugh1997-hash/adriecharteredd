    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { useApp } from \"../context/AppContext.jsx\";\nimport { CURRENCIES, CurrencyCode } from \"../types.js\";\nimport { UserCheck, ArrowLeft, Loader, Globe } from \"lucide-react\";\n\nconst COUNTRY_CODES = [\n  { code: \"+44\", country: \"United Kingdom\", flag: \"\360\237\207\254\360\237\207\247\" },\n  { code: \"+1\", country: \"United States / Canada\", flag: \"\360\237\207\272\360\237\207\270\" },\n  { code: \"+33\", country: \"France\", flag: \"\360\237\207\253\360\237\207\267\" },\n  { code: \"+49\", country: \"Germany\", flag: \"\360\237\207\251\360\237\207\252\" },\n  { code: \"+353\", country: \"Ireland\", flag: \"\360\237\207\256\360\237\207\252\" },\n  { code: \"+61\", country: \"Australia\", flag: \"\360\237\207\246\360\237\207\272\" },\n  { code: \"+64\", country: \"New Zealand\", flag: \"\360\237\207\263\360\237\207\277\" },\n  { code: \"+65\", country: \"Singapore\", flag: \"\360\237\207\270\360\237\207\254\" },\n  { code: \"+81\", country: \"Japan\", flag: \"\360\237\207\257\360\237\207\265\" },\n  { code: \"+971\", country: \"U.A.E.\", flag: \"\360\237\207\246\360\237\207\252\" },\n  { code: \"+852\", country: \"Hong Kong\", flag: \"\360\237\207\255\360\237\207\260\" },\n];\n\nexport default function SignupView() {\n  const { signup, setView } = useApp();\n  \n  const [fullName, setFullName] = useState(\"\");\n  const [email, setEmail] = useState(\"\");\n  const [phonePrefix, setPhonePrefix] = useState(\"+44\");\n  const [phoneRaw, setPhoneRaw] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [confirmPassword, setConfirmPassword] = useState(\"\");\n  const [currency, setCurrency] = useState<CurrencyCode>(\"GBP\");\n  \n  const [isSubmitting, setIsSubmitting] = useState(false);\n  const [error, setError] = useState(\"\");\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setError(\"\");\n\n    if (!fullName || !email || !phoneRaw || !password || !confirmPassword || !currency) {\n      setError(\"Please complete all sections to register.\");\n      return;\n    }\n\n    if (password !== confirmPassword) {\n      setError(\"Entered passwords do not match. Please verify.\");\n      return;\n    }\n\n    if (password.length < 6) {\n      setError(\"Security credentials must be 6 or more characters.\");\n      return;\n    }\n\n    setIsSubmitting(true);\n    // Combine phone prefix with body number correctly, strip out spacing\n    const cleanPhoneBody = phoneRaw.replace(/\\s+/g, \"\");\n    const formattedPhone = `${phonePrefix}${cleanPhoneBody}`;\n\n    try {\n      await signup({\n        fullName,\n        email,\n        phone: formattedPhone,\n        password,\n        currency,\n      });\n    } catch (err: any) {\n      setError(err.message || \"An error occurred setting up your online banking profile.\");\n    } finally {\n      setIsSubmitting(false);\n    }\n  };\n\n  return (\n    <div className=\"w-full max-w-lg bg-white rounded-2xl shadow-xl border border-blue-50 p-8 relative overflow-hidden\">\n      {/* Decorative top bar with AdrieChartered branding color */}\n      <div className=\"absolute top-0 left-0 right-0 h-1.5 bg-[#4A90D9]\" />\n\n      <div className=\"flex flex-col items-center mb-6\">\n        <div className=\"flex items-center gap-3 mb-2\">\n          <div className=\"w-10 h-10 rounded-xl bg-[#4A90D9] flex items-center justify-center shadow-md\">\n            <span className=\"text-white font-bold text-xl tracking-tighter\">AC</span>\n          </div>\n          <div className=\"flex flex-col\">\n            <h1 className=\"text-xl font-bold text-slate-950 tracking-tight leading-none\">AdrieChartered</h1>\n            <span className=\"text-[9px] text-slate-400 font-mono tracking-widest uppercase mt-0.5\">Established 1682</span>\n          </div>\n        </div>\n        <p className=\"text-slate-500 text-xs\">Register your personal digital banking profile</p>\n      </div>\n\n      <form onSubmit={handleSubmit} className=\"space-y-4\">\n        <div>\n          <label className=\"block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1\">Full Name</label>\n          <input\n            type=\"text\"\n            value={fullName}\n            onChange={(e) => setFullName(e.target.value)}\n            className=\"w-full px-4 h-10 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:border-[#4A90D9] focus:ring-1 focus:ring-[#4A90D9] outline-none transition-all placeholder:text-slate-400\"\n            placeholder=\"e.g. Florence Pugh\"\n            disabled={isSubmitting}\n            required\n          />\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n          <div>\n            <label className=\"block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1\">Email Address</label>\n            <input\n              type=\"email\"\n              value={email}\n              onChange={(e) => setEmail(e.target.value)}\n              className=\"w-full px-4 h-10 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:border-[#4A90D9] focus:ring-1 focus:ring-[#4A90D9] outline-none transition-all placeholder:text-slate-400\"\n              placeholder=\"florence@gmail.com\"\n              disabled={isSubmitting}\n              required\n            />\n          </div>\n\n          <div>\n            <label className=\"block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1\">Phone Number</label>\n            <div className=\"flex gap-1.5\">\n              <select\n                value={phonePrefix}\n                onChange={(e) => setPhonePrefix(e.target.value)}\n                className=\"px-2.5 h-10 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:border-[#4A90D9] outline-none font-mono\"\n                disabled={isSubmitting}\n              >\n                {COUNTRY_CODES.map((country) => (\n                  <option key={country.code} value={country.code}>\n                    {country.flag} {country.code}\n                  </option>\n                ))}\n              </select>\n              <input\n                type=\"tel\"\n                value={phoneRaw}\n                onChange={(e) => setPhoneRaw(e.target.value.replace(/[^0-9]/g, \"\"))}\n                className=\"flex-grow px-3 h-10 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:border-[#4A90D9] focus:ring-1 focus:ring-[#4A90D9] outline-none transition-all placeholder:text-slate-400 font-mono\"\n                placeholder=\"7911 123456\"\n                disabled={isSubmitting}\n                required\n              />\n            </div>\n          </div>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n          <div>\n            <label className=\"block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1\">Password</label>\n            <input\n              type=\"password\"\n              value={password}\n              onChange={(e) => setPassword(e.target.value)}\n              className=\"w-full px-4 h-10 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:border-[#4A90D9] focus:ring-1 focus:ring-[#4A90D9] outline-none transition-all placeholder:text-slate-400\"\n              placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n              disabled={isSubmitting}\n              required\n            />\n          </div>\n\n          <div>\n            <label className=\"block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1\">Confirm Password</label>\n            <input\n              type=\"password\"\n              value={confirmPassword}\n              onChange={(e) => setConfirmPassword(e.target.value)}\n              className=\"w-full px-4 h-10 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:border-[#4A90D9] focus:ring-1 focus:ring-[#4A90D9] outline-none transition-all placeholder:text-slate-400\"\n              placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n              disabled={isSubmitting}\n              required\n            />\n          </div>\n        </div>\n\n        <div>\n          <label className=\"block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1 flex items-center gap-1\">\n            <Globe className=\"w-3.5 h-3.5 text-[#4A90D9]\" />\n            Preferred Display Currency\n          </label>\n          <select\n            value={currency}\n            onChange={(e) => setCurrency(e.target.value as CurrencyCode)}\n            className=\"w-full px-3 h-10 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:border-[#4A90D9] outline-none transition-all cursor-pointer\"\n            disabled={isSubmitting}\n          >\n            {CURRENCIES.map((desc) => (\n              <option key={desc.code} value={desc.code}>\n                {desc.flag} {desc.code} \342\200\224 {desc.name} ({desc.symbol})\n              </option>\n            ))}\n          </select>\n        </div>\n\n        {error && (\n          <div className=\"p-3 bg-rose-50 border border-rose-150 rounded-xl text-xs font-medium text-rose-700 leading-snug\">\n            {error}\n          </div>\n        )}\n\n        <button\n          type=\"submit\"\n          className=\"w-full h-11 bg-[#4A90D9] hover:bg-[#3b7fc7] disabled:bg-[#4A90D9]/50 text-white font-medium rounded-xl text-sm items-center justify-center flex gap-2 transition-all cursor-pointer shadow-md shadow-blue-500/10 active:scale-[0.99]\"\n          disabled={isSubmitting}\n        >\n          {isSubmitting ? (\n            <>\n              <Loader className=\"w-4 h-4 animate-spin\" />\n              <span>Provisioning Digital Account...</span>\n            </>\n          ) : (\n            <>\n              <UserCheck className=\"w-4 h-4\" />\n              <span>Create Account</span>\n            </>\n          )}\n        </button>\n      </form>\n\n      <div className=\"mt-5 pt-5 border-t border-slate-100 flex items-center justify-between\">\n        <button\n          onClick={() => setView(\"login\")}\n          className=\"flex items-center gap-1.5 text-xs text-slate-500 hover:text-slate-800 transition-colors bg-transparent border-0 cursor-pointer p-0\"\n          disabled={isSubmitting}\n        >\n          <ArrowLeft className=\"w-3.5 h-3.5\" />\n          <span>Back to Sign In</span>\n        </button>\n        <span className=\"text-[10px] text-slate-400 font-mono tracking-tighter\">Secure SSL Enforced</span>\n      </div>\n    </div>\n  );\n}\n"
    }
