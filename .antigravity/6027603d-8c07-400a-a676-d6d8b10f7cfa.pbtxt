        }
        lines {
          text: "    const hrs = new Date().getHours();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (hrs < 12) return \"Good morning\";"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (hrs < 17) return \"Good afternoon\";"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    return \"Good evening\";"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
