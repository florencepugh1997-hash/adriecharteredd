      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQH7XPQQe_4Owe5u6kD6BqdeH9wv5HqPZAW4JIwCnNLMEYiIwrsU8BmFm8d3-4OSVr0fOdudJMZLhebq4l1ZNDDanM2MhaMK1bIKFdTpQAjrDUGVhX3Ic88WLh7cNl1HK0DbUp2OBECMVqQBNy2obV6fCuOWYtZnKacDT6dFiC5CUQw797wEzS-i4a4EWYjbiBAnmqLrkR1FNLZNi1pSwWU="
