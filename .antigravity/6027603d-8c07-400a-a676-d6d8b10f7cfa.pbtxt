        }
        lines {
          text: "                    onChange={(e) => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      const v = e.target.value.replace(/\\D/g, \"\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      const matches = v.match(/\\d{4,16}/g);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      const match = (matches && matches[0]) || \"\";"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      const parts = [];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      for (let i = 0, len = match.length; i < len; i += 4) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        parts.push(match.substring(i, i + 4));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
