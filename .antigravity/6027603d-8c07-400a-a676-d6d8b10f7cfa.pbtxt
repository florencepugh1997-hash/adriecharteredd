        target_content: "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>My Google AI Studio App</title>\n  </head>"
        replacement_content: "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <script>\n      (function() {\n        try {\n          var originalFetch = window.fetch || globalThis.fetch;\n          if (originalFetch) {\n            Object.defineProperty(window, \'fetch\', {\n              value: originalFetch,\n              writable: true,\n              configurable: true,\n              enumerable: true\n            });\n            if (typeof globalThis !== \'undefined\' && globalThis !== window) {\n              Object.defineProperty(globalThis, \'fetch\', {\n                value: originalFetch,\n                writable: true,\n                configurable: true,\n                enumerable: true\n              });\n            }\n          }\n        } catch (e) {\n          console.warn(\"Failed to make fetch writable:\", e);\n        }\n      })();\n    </script>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>My Google AI Studio App</title>\n  </head>"
      }
